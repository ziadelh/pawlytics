# Copy to .env and fill in. Never commit the real .env file.
# Node 20.6+ loads it with:  node --env-file=.env app.js

PORT=3000
NODE_ENV=development

# MongoDB (defaults to a local instance)
MONGO_URI=mongodb://localhost:27017/petai

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me

# URL of the Flask AI service (ai_service/orchestrator.py)
AI_SERVICE_URL=http://localhost:5002

# Optional: Gmail address + app password used for the welcome email.
# Create an app password at https://myaccount.google.com/apppasswords
# Leave blank to disable emails.
EMAIL_USER=
EMAIL_PASS=
